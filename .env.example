# SunStay environment variables
#
# IMPORTANT: Every VITE_* variable is compiled into the browser bundle.
# Never put any secret, unrestricted credential, service-role key, or provider key intended to remain confidential in VITE_* variables.
# For production scale, quota-sensitive third-party weather/AQ/UV keys should move
# behind server-side functions (for example Netlify Functions or Supabase Edge Functions).

# Required for the live map. Use a public Mapbox token that starts with "pk.".
# Restrict this token to your approved local/preview/production URLs in Mapbox.
VITE_MAPBOX_TOKEN=

# Optional OpenWeather key currently used client-side for the map cloud tile layer.
# This is exposed in the browser and is vulnerable to quota abuse until proxied server-side.
VITE_OPENWEATHER_KEY=

# Optional OpenAQ key currently used client-side for air-quality data.
# This is exposed in the browser and is vulnerable to quota abuse until proxied server-side.
VITE_OPENAQ_API_KEY=

# Optional OpenUV key currently used client-side for UV/safe-exposure data.
# This is exposed in the browser and is vulnerable to quota abuse until proxied server-side.
VITE_OPENUV_API_KEY=

# Optional Tomorrow.io key currently used client-side for short-term rain nowcasting.
# This is exposed in the browser and is vulnerable to quota abuse until proxied server-side.
VITE_TOMORROW_API_KEY=

# Optional Supabase project URL used by browser-side Supabase client features.
# Supabase browser configuration is public by design; production requires RLS.
VITE_SUPABASE_URL=

# Optional Supabase anon key used by browser-side Supabase client features.
# Anon keys are intentionally public, but production requires Supabase Row Level Security
# and authenticated owner-write policies. Never use or expose SUPABASE_SERVICE_ROLE_KEY
# or any service-role/private key in Vite/browser code.
VITE_SUPABASE_ANON_KEY=
